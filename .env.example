# ─── WhatsApp Campaign Manager — environment variables ───
# Copy to .env for local development. In Railway, set these as service variables.
# NEVER commit real values.

# PostgreSQL connection string (Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Public base URL of the web service (used for webhook URLs shown in the UI)
APP_URL="https://your-app.up.railway.app"
# Base URL for tracked links (/r/<token>). Can be a dedicated short domain pointing at the web service.
TRACKING_BASE_URL="https://your-app.up.railway.app"

# Random string, 32+ characters. Encrypts Meta access tokens and other secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it requires re-entering stored credentials.
ENCRYPTION_KEY=""
# Random string, 32+ characters. Keyed hashing of phone numbers (suppression list) and click fingerprints.
# Must NEVER change after go-live, or existing suppression hashes stop matching.
HASH_PEPPER=""

# ─── Meta / WhatsApp Cloud API ───
META_GRAPH_API_VERSION="v25.0"
# Platform-level Meta App (optional: each WhatsApp account can also store its own App ID/Secret)
META_APP_ID=""
META_APP_SECRET=""
# Verify token for the shared webhook endpoint /api/webhooks/whatsapp
META_WEBHOOK_VERIFY_TOKEN=""

# ─── Google Sheets (optional) ───
# Full JSON of a Google Cloud service account with Sheets read access (single line).
# Share each spreadsheet with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ─── Worker ───
WORKER_ID="worker-1"
LOG_LEVEL="info"

# ─── First-run bootstrap (used once by `pnpm db:seed`, then remove) ───
BOOTSTRAP_ORG_NAME="לינדר פיננסים"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
